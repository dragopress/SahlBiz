rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 1. GLOBAL PRIMITIVES & SECURITY HELPERS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'elbyoutydragopress@gmail.com' ||
        request.auth.token.email == 'admin@sahlbiz.ma'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Checks membership: creator, fallback, subcollection membership, or user document mapping
    function isOrgMember(orgId) {
      return isSignedIn() && (
        isAdmin() ||
        orgId == request.auth.uid ||
        orgId == ('org_' + request.auth.uid) ||
        ('org_' + request.auth.uid).matches('^' + orgId + '.*') ||
        exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         orgId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId)
      );
    }

    function getUserRole(orgId) {
      return isAdmin() ? 'admin' :
        (exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)) ?
          get(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid)).data.get('role', 'owner') :
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'owner') :
            'owner'));
    }

    function isOwnerOrAdmin(orgId) {
      return isAdmin() || (
        isOrgMember(orgId) && (
          getUserRole(orgId) == 'owner' ||
          getUserRole(orgId) == 'admin'
        )
      );
    }

    function hasPermission(orgId, permission) {
      return isOwnerOrAdmin(orgId) || (
        isOrgMember(orgId) && (
          (permission == 'customer.read' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'accountant' || getUserRole(orgId) == 'cashier' || getUserRole(orgId) == 'salesperson' || getUserRole(orgId) == 'viewer')) ||
          (permission == 'customer.create' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'cashier' || getUserRole(orgId) == 'salesperson')) ||
          (permission == 'customer.update' && (getUserRole(orgId) == 'manager')) ||
          (permission == 'customer.delete' && (getUserRole(orgId) == 'manager')) ||
          
          (permission == 'product.read' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'accountant' || getUserRole(orgId) == 'cashier' || getUserRole(orgId) == 'salesperson' || getUserRole(orgId) == 'inventory_manager' || getUserRole(orgId) == 'viewer')) ||
          (permission == 'product.create' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'inventory_manager')) ||
          (permission == 'product.update' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'inventory_manager')) ||
          (permission == 'product.delete' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'inventory_manager')) ||
          
          (permission == 'document.read' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'accountant' || getUserRole(orgId) == 'cashier' || getUserRole(orgId) == 'salesperson' || getUserRole(orgId) == 'viewer')) ||
          (permission == 'document.create' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'accountant' || getUserRole(orgId) == 'salesperson')) ||
          (permission == 'document.update' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'accountant')) ||
          (permission == 'document.delete' && (getUserRole(orgId) == 'manager')) ||
          
          (permission == 'expense.read' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'accountant' || getUserRole(orgId) == 'viewer')) ||
          (permission == 'expense.create' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'accountant')) ||
          (permission == 'expense.update' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'accountant')) ||
          (permission == 'expense.delete' && (getUserRole(orgId) == 'manager')) ||
          
          (permission == 'employee.read' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'hr_manager' || getUserRole(orgId) == 'viewer')) ||
          (permission == 'employee.create' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'hr_manager')) ||
          (permission == 'employee.update' && (getUserRole(orgId) == 'manager' || getUserRole(orgId) == 'hr_manager')) ||
          (permission == 'employee.delete' && (getUserRole(orgId) == 'manager'))
        )
      );
    }

    // ==========================================
    // 2. SCHEMA VALIDATION BLUEPRINTS
    // ==========================================

    function isValidBusinessProfile(p) {
      return p.name is string && p.name.size() > 0 && p.name.size() <= 100 &&
             p.type is string && (p.type == 'retail' || p.type == 'service' || p.type == 'wholesale' || p.type == 'artisan') &&
             p.ice is string && p.ice.size() <= 30 &&
             p.if is string && p.if.size() <= 30 &&
             p.rc is string && p.rc.size() <= 30 &&
             p.address is string && p.address.size() <= 300 &&
             p.city is string && p.city.size() <= 100 &&
             p.phone is string && p.phone.size() <= 30 &&
             p.email is string && p.email.size() <= 100 &&
             p.plan is string && (p.plan == 'free' || p.plan == 'starter' || p.plan == 'pro' || p.plan == 'business') &&
             p.orgId is string && p.orgId.size() <= 128;
    }

    function isValidCustomer(c) {
      return c.id is string && c.id.size() <= 128 &&
             c.name is string && c.name.size() > 0 && c.name.size() <= 100 &&
             c.phone is string && c.phone.size() <= 30 &&
             c.pricingTier is string && (c.pricingTier == 'standard' || c.pricingTier == 'wholesale' || c.pricingTier == 'vip') &&
             c.creditLimit is number && c.kreddyBalance is number &&
             c.createdAt is string && c.createdAt.size() <= 40 &&
             c.orgId is string && c.orgId.size() <= 128;
    }

    function isValidProduct(p) {
      return p.id is string && p.id.size() <= 128 &&
             p.name is string && p.name.size() > 0 && p.name.size() <= 150 &&
             p.sku is string && p.sku.size() <= 50 &&
             p.barcode is string && p.barcode.size() <= 50 &&
             p.category is string && p.category.size() <= 50 &&
             p.unit is string && (p.unit == 'piece' || p.unit == 'kg' || p.unit == 'liter' || p.unit == 'box' || p.unit == 'carton' || p.unit == 'service') &&
             p.costPrice is number && p.sellingPrice is number &&
             p.tvaRate is number && (p.tvaRate == 20 || p.tvaRate == 14 || p.tvaRate == 10 || p.tvaRate == 7 || p.tvaRate == 0) &&
             p.stockQty is number && p.minStockAlert is number &&
             p.location is string && (p.location == 'magasin' || p.location == 'depot' || p.location == 'all') &&
             p.orgId is string && p.orgId.size() <= 128;
    }

    function isValidSupplier(s) {
      return s.id is string && s.id.size() <= 128 &&
             s.name is string && s.name.size() > 0 && s.name.size() <= 100 &&
             s.phone is string && s.phone.size() <= 30 &&
             s.category is string && s.category.size() <= 50 &&
             s.outstandingDebt is number &&
             s.orgId is string && s.orgId.size() <= 128;
    }

    function isValidBusinessDocument(d) {
      return d.id is string && d.id.size() <= 128 &&
             d.number is string && d.number.size() <= 50 &&
             d.type is string && (d.type == 'devis' || d.type == 'facture' || d.type == 'bl' || d.type == 'commande') &&
             d.customerId is string && d.customerId.size() <= 128 &&
             d.customerName is string && d.customerName.size() <= 100 &&
             d.date is string && d.date.size() <= 40 &&
             d.dueDate is string && d.dueDate.size() <= 40 &&
             d.items is list && d.items.size() <= 100 &&
             d.subtotalHt is number && d.totalTva is number && d.totalTtc is number &&
             d.paidAmount is number && d.remainingAmount is number &&
             d.status is string && (d.status == 'unpaid' || d.status == 'partial' || d.status == 'paid' || d.status == 'overdue') &&
             d.orgId is string && d.orgId.size() <= 128;
    }

    function isValidExpense(e) {
      return e.id is string && e.id.size() <= 128 &&
             e.title is string && e.title.size() > 0 && e.title.size() <= 150 &&
             e.category is string && (e.category == 'loyer' || e.category == 'salaires' || e.category == 'matieres' || e.category == 'transport' || e.category == 'electricite' || e.category == 'impots' || e.category == 'entretiens' || e.category == 'divers') &&
             e.amountHt is number && e.tvaRate is number && e.tvaAmount is number && e.amountTtc is number &&
             e.date is string && e.date.size() <= 40 &&
             e.vendorName is string && e.vendorName.size() <= 100 &&
             e.paymentMethod is string && (e.paymentMethod == 'cash' || e.paymentMethod == 'check' || e.paymentMethod == 'traite' || e.paymentMethod == 'cmi_card' || e.paymentMethod == 'transfer' || e.paymentMethod == 'kreddy') &&
             e.orgId is string && e.orgId.size() <= 128;
    }

    function isValidEmployee(emp) {
      return emp.id is string && emp.id.size() <= 128 &&
             emp.name is string && emp.name.size() > 0 && emp.name.size() <= 100 &&
             emp.role is string && emp.role.size() <= 50 &&
             emp.cin is string && emp.cin.size() <= 15 &&
             emp.cnssNumber is string && emp.cnssNumber.size() <= 20 &&
             emp.phone is string && emp.phone.size() <= 30 &&
             emp.baseSalary is number &&
             emp.orgId is string && emp.orgId.size() <= 128;
    }

    function isValidInventoryMovement(m) {
      return m.id is string && m.id.size() <= 128 &&
             m.organizationId is string && m.organizationId.size() <= 128 &&
             m.productId is string && m.productId.size() <= 128 &&
             m.productName is string && m.productName.size() <= 150 &&
             m.type is string && (m.type == 'purchase' || m.type == 'sale' || m.type == 'return' || m.type == 'adjustment_in' || m.type == 'adjustment_out' || m.type == 'transfer' || m.type == 'opening_balance') &&
             m.quantity is number && m.quantity >= 0 &&
             m.createdAt is string && m.createdAt.size() <= 40 &&
             m.createdBy is string && m.createdBy.size() <= 100;
    }

    function isValidBusinessEvent(ev) {
      return ev.id is string && ev.id.size() <= 128 &&
             ev.eventType is string && ev.eventType.size() <= 100 &&
             ev.timestamp is string && ev.timestamp.size() <= 40 &&
             ev.userId is string && ev.userId.size() <= 128 &&
             ev.userName is string && ev.userName.size() <= 100 &&
             ev.orgId is string && ev.orgId.size() <= 128 &&
             ev.hash is string && ev.hash.size() <= 128 &&
             ev.status is string && (ev.status == 'valid' || ev.status == 'corrupted' || ev.status == 'unverified');
    }

    function isValidCreditLedgerEntry(cle) {
      return cle.id is string && cle.id.size() <= 128 &&
             cle.customerId is string && cle.customerId.size() <= 128 &&
             cle.type is string && (cle.type == 'opening_balance' || cle.type == 'credit_sale' || cle.type == 'payment' || cle.type == 'return' || cle.type == 'adjustment_plus' || cle.type == 'adjustment_minus') &&
             cle.amount is number && cle.amount >= 0 &&
             cle.createdAt is string && cle.createdAt.size() <= 40 &&
             cle.createdBy is string && cle.createdBy.size() <= 100 &&
             cle.orgId is string && cle.orgId.size() <= 128;
    }

    function isValidAccount(acc) {
      return acc.id is string && acc.id.size() <= 128 &&
             acc.code is string && acc.code.size() <= 20 &&
             acc.name is string && acc.name.size() <= 200 &&
             acc.accountClass is number &&
             acc.type is string &&
             acc.orgId is string && acc.orgId.size() <= 128;
    }

    function isValidJournalEntry(entry) {
      return entry.id is string && entry.id.size() <= 128 &&
             entry.entryNumber is string && entry.entryNumber.size() <= 60 &&
             entry.journalCode is string && entry.journalCode.size() <= 10 &&
             entry.date is string && entry.date.size() <= 40 &&
             entry.description is string && entry.description.size() <= 255 &&
             entry.totalDebit is number && entry.totalDebit >= 0 &&
             entry.totalCredit is number && entry.totalCredit >= 0 &&
             entry.isBalanced is bool && entry.isBalanced == true &&
             entry.status is string &&
             entry.orgId is string && entry.orgId.size() <= 128;
    }

    function isValidFiscalPeriod(fp) {
      return fp.id is string && fp.id.size() <= 128 &&
             fp.name is string && fp.name.size() <= 100 &&
             fp.startDate is string && fp.startDate.size() <= 40 &&
             fp.endDate is string && fp.endDate.size() <= 40 &&
             fp.status is string &&
             fp.orgId is string && fp.orgId.size() <= 128;
    }

    // ==========================================
    // 3. SECURE ACCESS CONTROL PATH RULES
    // ==========================================

    // Catch-all Default-Deny Security Barrier (Pillar 1)
    match /{document=**} {
      allow read, write: if false;
    }

    // System Config Collection: Read-Only for Auth users, Admins Write (Pillar 6)
    match /systemConfig/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Subscriptions Collection: Client cannot write, Server-managed (Pillar 6)
    match /subscriptions/{subId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin Verification Registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && adminId == request.auth.uid && isEmailVerified();
    }

    // User Directory: Strict Profile Ownership + Non-Admin Role/Org Isolation
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && (
        incoming().get('role', 'owner') != 'admin' &&
        isValidId(incoming().orgId)
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && (
          incoming().get('role', 'owner') == existing().get('role', 'owner') &&
          incoming().get('orgId', '') == existing().get('orgId', '')
        )) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // 4. CANONICAL TENANT-ISOLATED ORGANIZATIONS
    // ==========================================

    match /organizations/{orgId} {
      allow read: if isValidId(orgId) && isOrgMember(orgId);
      allow write: if isValidId(orgId) && isOwnerOrAdmin(orgId);

      // Members directory: strictly validates membership, owner/admin role, and matching tenant orgId
      match /members/{memberId} {
        allow get: if isValidId(orgId) && isValidId(memberId) && isOrgMember(orgId) && (request.auth.uid == memberId || isOwnerOrAdmin(orgId));
        allow list: if isValidId(orgId) && isOrgMember(orgId) && isOwnerOrAdmin(orgId);
        allow create: if isValidId(orgId) && isValidId(memberId) && isOwnerOrAdmin(orgId) && incoming().orgId == orgId;
        allow update: if isValidId(orgId) && isValidId(memberId) && incoming().orgId == orgId && (
          isOwnerOrAdmin(orgId) || 
          (request.auth.uid == memberId && incoming().get('role', 'owner') == existing().get('role', 'owner'))
        );
        allow delete: if isValidId(orgId) && isValidId(memberId) && isOwnerOrAdmin(orgId);
      }

      // Business Profile: strictly validates membership, owner/admin role, and matching tenant orgId
      match /businessProfiles/{profileId} {
        allow get: if isValidId(orgId) && isValidId(profileId) && isOrgMember(orgId);
        allow list: if isValidId(orgId) && isOrgMember(orgId);
        allow create, update: if isValidId(orgId) && isValidId(profileId) && isOwnerOrAdmin(orgId) && incoming().orgId == orgId && isValidBusinessProfile(incoming());
        allow delete: if isValidId(orgId) && isValidId(profileId) && isOwnerOrAdmin(orgId);
      }

      // Customers: strictly validates membership, 'customer' roles/permissions, and matching tenant orgId
      match /customers/{customerId} {
        allow get: if isValidId(orgId) && isValidId(customerId) && isOrgMember(orgId) && hasPermission(orgId, 'customer.read');
        allow list: if isValidId(orgId) && isOrgMember(orgId) && hasPermission(orgId, 'customer.read') && resource.data.orgId == orgId;
        allow create: if isValidId(orgId) && isValidId(customerId) && hasPermission(orgId, 'customer.create') && incoming().orgId == orgId && isValidCustomer(incoming());
        allow update: if isValidId(orgId) && isValidId(customerId) && hasPermission(orgId, 'customer.update') && incoming().orgId == orgId && isValidCustomer(incoming());
        allow delete: if isValidId(orgId) && isValidId(customerId) && hasPermission(orgId, 'customer.delete');
      }

      // Products: strictly validates membership, 'product' roles/permissions, and matching tenant orgId
      match /products/{productId} {
        allow get: if isValidId(orgId) && isValidId(productId) && isOrgMember(orgId) && hasPermission(orgId, 'product.read');
        allow list: if isValidId(orgId) && isOrgMember(orgId) && hasPermission(orgId, 'product.read') && resource.data.orgId == orgId;
        allow create: if isValidId(orgId) && isValidId(productId) && hasPermission(orgId, 'product.create') && incoming().orgId == orgId && isValidProduct(incoming());
        allow update: if isValidId(orgId) && isValidId(productId) && hasPermission(orgId, 'product.update') && incoming().orgId == orgId && isValidProduct(incoming());
        allow delete: if isValidId(orgId) && isValidId(productId) && hasPermission(orgId, 'product.delete');
      }

      // Suppliers: strictly validates membership, 'customer/supplier' roles/permissions, and matching tenant orgId
      match /suppliers/{supplierId} {
        allow get: if isValidId(orgId) && isValidId(supplierId) && isOrgMember(orgId) && hasPermission(orgId, 'customer.read');
        allow list: if isValidId(orgId) && isOrgMember(orgId) && hasPermission(orgId, 'customer.read') && resource.data.orgId == orgId;
        allow create: if isValidId(orgId) && isValidId(supplierId) && hasPermission(orgId, 'customer.create') && incoming().orgId == orgId && isValidSupplier(incoming());
        allow update: if isValidId(orgId) && isValidId(supplierId) && hasPermission(orgId, 'customer.update') && incoming().orgId == orgId && isValidSupplier(incoming());
        allow delete: if isValidId(orgId) && isValidId(supplierId) && hasPermission(orgId, 'customer.delete');
      }

      // Documents: strictly validates membership, 'document' roles/permissions, and matching tenant orgId
      match /documents/{documentId} {
        allow get: if isValidId(orgId) && isValidId(documentId) && isOrgMember(orgId) && hasPermission(orgId, 'document.read');
        allow list: if isValidId(orgId) && isOrgMember(orgId) && hasPermission(orgId, 'document.read') && resource.data.orgId == orgId;
        allow create: if isValidId(orgId) && isValidId(documentId) && hasPermission(orgId, 'document.create') && incoming().orgId == orgId && isValidBusinessDocument(incoming());
        allow update: if isValidId(orgId) && isValidId(documentId) && hasPermission(orgId, 'document.update') && incoming().orgId == orgId && isValidBusinessDocument(incoming());
        allow delete: if isValidId(orgId) && isValidId(documentId) && hasPermission(orgId, 'document.delete');
      }

      // Expenses: strictly validates membership, 'expense' roles/permissions, and matching tenant orgId
      match /expenses/{expenseId} {
        allow get: if isValidId(orgId) && isValidId(expenseId) && isOrgMember(orgId) && hasPermission(orgId, 'expense.read');
        allow list: if isValidId(orgId) && isOrgMember(orgId) && hasPermission(orgId, 'expense.read') && resource.data.orgId == orgId;
        allow create: if isValidId(orgId) && isValidId(expenseId) && hasPermission(orgId, 'expense.create') && incoming().orgId == orgId && isValidExpense(incoming());
        allow update: if isValidId(orgId) && isValidId(expenseId) && hasPermission(orgId, 'expense.update') && incoming().orgId == orgId && isValidExpense(incoming());
        allow delete: if isValidId(orgId) && isValidId(expenseId) && hasPermission(orgId, 'expense.delete');
      }

      // Employees: strictly validates membership, 'employee' roles/permissions, and matching tenant orgId
      match /employees/{employeeId} {
        allow get: if isValidId(orgId) && isValidId(employeeId) && isOrgMember(orgId) && hasPermission(orgId, 'employee.read');
        allow list: if isValidId(orgId) && isOrgMember(orgId) && hasPermission(orgId, 'employee.read') && resource.data.orgId == orgId;
        allow create: if isValidId(orgId) && isValidId(employeeId) && hasPermission(orgId, 'employee.create') && incoming().orgId == orgId && isValidEmployee(incoming());
        allow update: if isValidId(orgId) && isValidId(employeeId) && hasPermission(orgId, 'employee.update') && incoming().orgId == orgId && isValidEmployee(incoming());
        allow delete: if isValidId(orgId) && isValidId(employeeId) && hasPermission(orgId, 'employee.delete');
      }

      // InventoryMovements: strictly validates membership, 'product' roles/permissions, and matching tenant organizationId
      match /inventoryMovements/{movementId} {
        allow get: if isValidId(orgId) && isValidId(movementId) && isOrgMember(orgId) && hasPermission(orgId, 'product.read');
        allow list: if isValidId(orgId) && isOrgMember(orgId) && hasPermission(orgId, 'product.read') && (resource == null || resource.data.organizationId == orgId);
        allow create, update: if isValidId(orgId) && isValidId(movementId) && hasPermission(orgId, 'product.update') && incoming().organizationId == orgId && isValidInventoryMovement(incoming());
        allow delete: if isValidId(orgId) && isValidId(movementId) && hasPermission(orgId, 'product.delete');
      }

      // Cash register, session, movement and reconciliation systems
      match /cashRegisters/{registerId} {
        allow read, write: if isValidId(orgId) && isOrgMember(orgId);
      }
      match /cashSessions/{sessionId} {
        allow read, write: if isValidId(orgId) && isOrgMember(orgId);
      }
      match /cashMovements/{movementId} {
        allow read, write: if isValidId(orgId) && isOrgMember(orgId);
      }
      match /cashReconciliations/{reconciliationId} {
        allow read, write: if isValidId(orgId) && isOrgMember(orgId);
      }

      // BusinessEvents: read and create for organizational members with appropriate validation
      match /businessEvents/{eventId} {
        allow get, list: if isValidId(orgId) && isOrgMember(orgId);
        allow create: if isValidId(orgId) && isValidId(eventId) && isOrgMember(orgId) && incoming().orgId == orgId && isValidBusinessEvent(incoming());
      }

      // CreditLedger: read and write for organizational members with customer read/update permissions and schema validation
      match /creditLedger/{entryId} {
        allow get, list: if isValidId(orgId) && isOrgMember(orgId) && hasPermission(orgId, 'customer.read');
        allow create: if isValidId(orgId) && isValidId(entryId) && hasPermission(orgId, 'customer.create') && incoming().orgId == orgId && isValidCreditLedgerEntry(incoming());
      }

      // ========================================================
      // 5. DOUBLE-ENTRY ACCOUNTING & FISCAL ENGINE (PCGM)
      // ========================================================

      // Chart of Accounts (Plan Comptable)
      match /accounts/{accountId} {
        allow get, list: if isValidId(orgId) && isOrgMember(orgId);
        allow create, update: if isValidId(orgId) && isValidId(accountId) && isOrgMember(orgId) && incoming().orgId == orgId && isValidAccount(incoming());
        allow delete: if isValidId(orgId) && isValidId(accountId) && isOwnerOrAdmin(orgId);
      }

      // Accounting Journals (VE, AC, BQ, CA, OD, AN)
      match /journals/{journalId} {
        allow get, list: if isValidId(orgId) && isOrgMember(orgId);
        allow create, update: if isValidId(orgId) && isValidId(journalId) && isOrgMember(orgId) && incoming().orgId == orgId;
        allow delete: if isValidId(orgId) && isValidId(journalId) && isOwnerOrAdmin(orgId);
      }

      // Journal Entries (Double-Entry Invariant Guarded)
      match /journalEntries/{entryId} {
        allow get, list: if isValidId(orgId) && isOrgMember(orgId);
        allow create: if isValidId(orgId) && isValidId(entryId) && isOrgMember(orgId) && incoming().orgId == orgId && isValidJournalEntry(incoming());
        allow update: if isValidId(orgId) && isValidId(entryId) && isOrgMember(orgId) && incoming().orgId == orgId && isValidJournalEntry(incoming());
        allow delete: if isValidId(orgId) && isValidId(entryId) && isOwnerOrAdmin(orgId);
      }

      // Fiscal Periods & Closing
      match /fiscalPeriods/{periodId} {
        allow get, list: if isValidId(orgId) && isOrgMember(orgId);
        allow create, update: if isValidId(orgId) && isValidId(periodId) && isOrgMember(orgId) && incoming().orgId == orgId && isValidFiscalPeriod(incoming());
        allow delete: if isValidId(orgId) && isValidId(periodId) && isOwnerOrAdmin(orgId);
      }

      // Tax Entries & VAT Declarations
      match /taxEntries/{taxEntryId} {
        allow get, list: if isValidId(orgId) && isOrgMember(orgId);
        allow create, update: if isValidId(orgId) && isValidId(taxEntryId) && isOrgMember(orgId) && incoming().orgId == orgId;
        allow delete: if isValidId(orgId) && isValidId(taxEntryId) && isOwnerOrAdmin(orgId);
      }

      // Accounting Payments & Settlements
      match /accountingPayments/{paymentId} {
        allow get, list: if isValidId(orgId) && isOrgMember(orgId);
        allow create, update: if isValidId(orgId) && isValidId(paymentId) && isOrgMember(orgId) && incoming().orgId == orgId;
        allow delete: if isValidId(orgId) && isValidId(paymentId) && isOwnerOrAdmin(orgId);
      }

      // Bank & Cash Reconciliations (Rapprochement bancaire)
      match /reconciliations/{reconciliationId} {
        allow get, list: if isValidId(orgId) && isOrgMember(orgId);
        allow create, update: if isValidId(orgId) && isValidId(reconciliationId) && isOrgMember(orgId) && incoming().orgId == orgId;
        allow delete: if isValidId(orgId) && isValidId(reconciliationId) && isOwnerOrAdmin(orgId);
      }
    }

    // ==========================================
    // 5. BACKWARD COMPATIBLE FILTER-ENFORCED ROOT
    // ==========================================

    function isOrgAccess(data) {
      return isSignedIn() && data.orgId is string && isOrgMember(data.orgId);
    }

    match /businessProfiles/{profileId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(profileId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing())) && isValidBusinessProfile(incoming());
      allow delete: if isSignedIn() && isValidId(profileId) && (resource == null || isOrgAccess(existing()));
    }

    match /customers/{customerId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(customerId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing())) && isValidCustomer(incoming());
      allow delete: if isSignedIn() && isValidId(customerId) && (resource == null || isOrgAccess(existing()));
    }

    match /products/{productId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(productId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing())) && isValidProduct(incoming());
      allow delete: if isSignedIn() && isValidId(productId) && (resource == null || isOrgAccess(existing()));
    }

    match /suppliers/{supplierId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(supplierId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing())) && isValidSupplier(incoming());
      allow delete: if isSignedIn() && isValidId(supplierId) && (resource == null || isOrgAccess(existing()));
    }

    match /documents/{documentId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(documentId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing())) && isValidBusinessDocument(incoming());
      allow delete: if isSignedIn() && isValidId(documentId) && (resource == null || isOrgAccess(existing()));
    }

    match /expenses/{expenseId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(expenseId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing())) && isValidExpense(incoming());
      allow delete: if isSignedIn() && isValidId(expenseId) && (resource == null || isOrgAccess(existing()));
    }

    match /employees/{employeeId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(employeeId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing())) && isValidEmployee(incoming());
      allow delete: if isSignedIn() && isValidId(employeeId) && (resource == null || isOrgAccess(existing()));
    }

    match /inventoryMovements/{movementId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgMember(resource.data.organizationId));
      allow create: if isSignedIn() && isValidId(movementId) && isOrgMember(incoming().organizationId) && isValidInventoryMovement(incoming());
    }

    match /cashRegisters/{registerId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(registerId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing()));
      allow delete: if isSignedIn() && isValidId(registerId) && (resource == null || isOrgAccess(existing()));
    }
    match /cashSessions/{sessionId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(sessionId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing()));
      allow delete: if isSignedIn() && isValidId(sessionId) && (resource == null || isOrgAccess(existing()));
    }
    match /cashMovements/{movementId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(movementId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing()));
      allow delete: if isSignedIn() && isValidId(movementId) && (resource == null || isOrgAccess(existing()));
    }
    match /cashReconciliations/{reconciliationId} {
      allow get, list: if isSignedIn() && (resource == null || isOrgAccess(resource.data));
      allow create, update: if isSignedIn() && isValidId(reconciliationId) && isOrgAccess(incoming()) && (resource == null || isOrgAccess(existing()));
      allow delete: if isSignedIn() && isValidId(reconciliationId) && (resource == null || isOrgAccess(existing()));
    }
  }
}
