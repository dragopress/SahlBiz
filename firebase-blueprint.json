{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile and organization assignment",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 100 },
        "displayName": { "type": "string", "maxLength": 100 },
        "orgId": { "type": "string", "maxLength": 128 },
        "orgName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "maxLength": 30 }
      },
      "required": ["uid", "email", "orgId", "orgName"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Server-side administrator list document",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 30 },
        "verifiedAt": { "type": "string", "maxLength": 30 }
      },
      "required": ["email", "role"]
    },
    "BusinessProfile": {
      "title": "BusinessProfile",
      "description": "Business profile and Moroccan tax identity",
      "type": "object",
      "properties": {
        "orgId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["retail", "service", "wholesale", "artisan"] },
        "ice": { "type": "string", "maxLength": 15 },
        "if": { "type": "string", "maxLength": 20 },
        "rc": { "type": "string", "maxLength": 20 },
        "rcCity": { "type": "string", "maxLength": 50 },
        "patente": { "type": "string", "maxLength": 20 },
        "cnss": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "bankName": { "type": "string", "maxLength": 100 },
        "bankRib": { "type": "string", "maxLength": 30 },
        "defaultTvaRate": { "type": "number" },
        "plan": { "type": "string", "enum": ["free", "starter", "pro", "business"] }
      },
      "required": ["name", "ice", "plan", "orgId"]
    },
    "Customer": {
      "title": "Customer",
      "description": "B2B or B2C customer record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orgId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "ice": { "type": "string", "maxLength": 15 },
        "address": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 50 },
        "pricingTier": { "type": "string", "enum": ["standard", "wholesale", "vip"] },
        "creditLimit": { "type": "number" },
        "kreddyBalance": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 30 }
      },
      "required": ["id", "orgId", "name", "phone", "pricingTier", "creditLimit", "kreddyBalance", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orgId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 150 },
        "sku": { "type": "string", "maxLength": 50 },
        "barcode": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "unit": { "type": "string", "enum": ["piece", "kg", "liter", "box", "carton", "service"] },
        "costPrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "tvaRate": { "type": "number" },
        "stockQty": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "location": { "type": "string", "enum": ["magasin", "depot", "all"] }
      },
      "required": ["id", "orgId", "name", "category", "unit", "sellingPrice", "stockQty"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier vendor record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orgId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "ice": { "type": "string", "maxLength": 15 },
        "category": { "type": "string", "maxLength": 50 },
        "outstandingDebt": { "type": "number" }
      },
      "required": ["id", "orgId", "name", "category", "outstandingDebt"]
    },
    "BusinessDocument": {
      "title": "BusinessDocument",
      "description": "Invoice, quote, delivery note or order document",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orgId": { "type": "string", "maxLength": 128 },
        "number": { "type": "string", "maxLength": 50 },
        "type": { "type": "string", "enum": ["devis", "facture", "bl", "commande"] },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 30 },
        "dueDate": { "type": "string", "maxLength": 30 },
        "subtotalHt": { "type": "number" },
        "totalTva": { "type": "number" },
        "totalTtc": { "type": "number" },
        "paidAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["unpaid", "partial", "paid", "overdue"] }
      },
      "required": ["id", "orgId", "number", "type", "customerId", "customerName", "date", "status"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Business expense entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orgId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string" },
        "amountHt": { "type": "number" },
        "tvaRate": { "type": "number" },
        "amountTtc": { "type": "number" },
        "date": { "type": "string", "maxLength": 30 },
        "vendorName": { "type": "string", "maxLength": 100 },
        "paymentMethod": { "type": "string" }
      },
      "required": ["id", "orgId", "title", "category", "amountTtc", "date"]
    },
    "Employee": {
      "title": "Employee",
      "description": "HR Employee entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orgId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "cin": { "type": "string", "maxLength": 20 },
        "phone": { "type": "string", "maxLength": 30 },
        "baseSalary": { "type": "number" }
      },
      "required": ["id", "orgId", "name", "role", "baseSalary"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User accounts and organization multi-tenancy mappings"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Server-side validated administrator list"
    },
    "/organizations/{orgId}": {
      "description": "Organizational root tenants with subcollection isolation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "/organizations/{orgId}/members/{userId}": {
      "description": "Organization membership records mapped to user IDs",
      "schema": { "$ref": "#/entities/User" }
    },
    "/organizations/{orgId}/businessProfiles/{profileId}": {
      "schema": { "$ref": "#/entities/BusinessProfile" },
      "description": "Business profile settings scoped to tenant"
    },
    "/organizations/{orgId}/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customers list scoped to tenant"
    },
    "/organizations/{orgId}/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products catalog scoped to tenant"
    },
    "/organizations/{orgId}/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Suppliers list scoped to tenant"
    },
    "/organizations/{orgId}/documents/{documentId}": {
      "schema": { "$ref": "#/entities/BusinessDocument" },
      "description": "Business invoices and devis documents scoped to tenant"
    },
    "/organizations/{orgId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Business expenses scoped to tenant"
    },
    "/organizations/{orgId}/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Employee directory scoped to tenant"
    }
  }
}
